{
  "id": "/app/",
  "name": "Mersin Tantuni Dalston",
  "short_name": "Mersin",
  "description": "Order collection or delivery from Mersin Tantuni Dalston. The current menu, saved details and table requests in one app.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f6f0e4",
  "theme_color": "#07130e",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Order collection",
      "short_name": "Collection",
      "url": "./?type=collection",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Order delivery",
      "short_name": "Delivery",
      "url": "./?type=delivery",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Reserve a table",
      "short_name": "Reserve",
      "url": "./?view=reserve",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
